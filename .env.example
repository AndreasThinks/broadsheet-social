# Public URL of the app. Leave unset on a laptop (defaults to http://127.0.0.1:5001).
BASE_URL=https://your-app.up.railway.app
# Long random string. Signs your login cookie and encrypts stored tokens. Keep it stable.
SECRET_KEY=change-me
# Password for the app itself. Required anywhere other than your own machine.
APP_PASSWORD=change-me
# Shown to push services as a contact address.
CONTACT_EMAIL=you@example.com
# Where the database and editable feeds live.
DATA_DIR=data
FEEDS_DIR=feeds
# Optional tuning
POLL_SECONDS=60
CACHE_HOURS=48
# Sample accounts with fake posts, to try the UI without signing in.
DEMO=false
# X (experimental, pay-per-use). Create an app at developer.x.com with OAuth 2.0,
# callback <BASE_URL>/auth/x/callback.
X_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MONTHLY_CAP_USD=10
